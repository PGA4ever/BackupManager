<Window x:Class="BackupManagerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Backup Manager Pro" Height="700" Width="800"
        Background="#D4E8D4" WindowStartupLocation="CenterScreen"
        >


    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab Control -->
        <TabControl Grid.Row="0" Grid.RowSpan="2">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- Add Game -->
                        <GroupBox Header="Add Game for Backup" Margin="0,0,0,15" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Game Name:" Grid.Row="0" Grid.Column="0" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                <TextBox x:Name="GameNameEntry" Grid.Row="0" Grid.Column="1" Margin="0,0,5,5"/>

                                <TextBlock Text="Source Path:" Grid.Row="1" Grid.Column="0" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                <TextBox x:Name="SourceDirEntry" Grid.Row="1" Grid.Column="1" Margin="0,0,5,5" IsReadOnly="True"/>
                                <Button Content="..." Grid.Row="1" Grid.Column="2" Width="30" Click="SelectSource_Click"/>

                                <TextBlock Text="Backup Path:" Grid.Row="2" Grid.Column="0" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                <TextBox x:Name="BackupDirEntry" Grid.Row="2" Grid.Column="1" Margin="0,0,5,5" IsReadOnly="True" Text="{Binding DefaultBackupDir}" Foreground="Gray"/>
                                <Button Content="..." Grid.Row="2" Grid.Column="2" Width="30" Click="SelectBackup_Click"/>

                                <Button Content="Add Game" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0" Click="AddGame_Click"/>
                            </Grid>
                        </GroupBox>

                        <!-- Game List -->
                        <GroupBox Header="Configured Games" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" Grid.Row="0" CellEditEnding="GamesGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Backup" Binding="{Binding IsSelected}" Width="60"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="200"/>
                                        <DataGridTextColumn Header="Backup" Binding="{Binding Backup}" Width="200"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeMB}" Width="80"/>
                                        <DataGridTextColumn Header="Backups" Binding="{Binding BackupCount}" Width="80"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open Backup Folder" Click="OpenBackupFolder_Click"/>
                                            <MenuItem Header="Copy" Click="CopyText_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                                    <Button Content="Manual Backup" Width="120" Margin="5" Click="ManualBackup_Click"/>
                                    <Button Content="Restore" Width="120" Margin="5" Click="RestoreBackup_Click"/>
                                    <Button Content="Delete" Width="120" Margin="5" Click="DeleteGame_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Progress + Status -->
                        <ProgressBar x:Name="ProgressBar" Height="20" Margin="0,15" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="StatusText" Text="Ready." Margin="0,5" Foreground="DarkGreen" FontWeight="Bold"/>

                        <!-- Auto-Backup Settings -->
                        <GroupBox Header="Auto-Backup" Margin="0,15,0,15" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Enable/Disable -->
                                <CheckBox x:Name="AutoBackupEnabled" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Enable Auto-Backup" Margin="0,0,0,10" Checked="AutoBackupEnabled_Checked" Unchecked="AutoBackupEnabled_Unchecked"/>

                                <!-- Interval Selection -->
                                <TextBlock Text="Interval:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
                                <ComboBox x:Name="AutoBackupInterval" Grid.Column="1" Margin="0,25,0,5" SelectionChanged="AutoBackupInterval_SelectionChanged" Grid.ColumnSpan="2" HorizontalAlignment="Left" Grid.RowSpan="2" Width="200">
                                    <ComboBoxItem>30 minutes</ComboBoxItem>
                                    <ComboBoxItem>1 hour</ComboBoxItem>
                                    <ComboBoxItem>2 hours</ComboBoxItem>
                                    <ComboBoxItem>6 hours</ComboBoxItem>
                                    <ComboBoxItem>24 hours</ComboBoxItem>
                                    <ComboBoxItem>2 days</ComboBoxItem>
                                    <ComboBoxItem>7 days</ComboBoxItem>
                                </ComboBox>

                                <!-- Status Info -->
                                <TextBlock Text="Status:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,5"/>
                                <TextBlock x:Name="AutoBackupStatus" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="Disabled" Foreground="Gray" Margin="0,0,0,5"/>

                                <!-- Last Backup Time -->
                                <TextBlock Text="Last Backup:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="LastBackupTime" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="Never" Foreground="Gray"/>
                            </Grid>
                        </GroupBox>

                        <!-- Log -->
                        <GroupBox Header="Log" Margin="0,15,0,0" Padding="10">
                            <ListView x:Name="LogList" Height="150" FontFamily="Consolas" FontSize="11"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="20">
                    <CheckBox x:Name="NotificationsCheck" Content="Enable System Notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,10"/>

                    <CheckBox x:Name="StartupCheck" Content="Start Application at Windows Startup" Margin="0,0,0,10" Checked="StartupCheck_Checked" Unchecked="StartupCheck_Unchecked"/>

                    <GroupBox Header="Default Backup Folder" Padding="10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Path:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding DefaultBackupDir}" IsReadOnly="True" Margin="10,0"/>
                            <Button Grid.Column="2" Content="..." Width="30" Click="SelectDefaultBackup_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- Updates Section -->
                    <GroupBox Header="Application Updates" Padding="10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Current Version:" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CurrentVersionText" Grid.Row="0" Grid.Column="1" Text="1.0.0" Margin="0,0,0,10" VerticalAlignment="Center" Foreground="DarkGreen" FontWeight="Bold"/>

                            <Button Content="Check for Updates" Grid.Row="1" Grid.Column="0" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10" Click="CheckForUpdates_Click"/>
                            <TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="" Margin="10,0,0,10" VerticalAlignment="Center" Foreground="Gray"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Updates are downloaded from the official GitHub repository." FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                        </Grid>
                    </GroupBox>

                    <Button Content="Open Log File" Width="150" HorizontalAlignment="Left" Margin="0,0,0,5" Click="OpenLog_Click"/>
                    <Button Content="Clear Log File" Width="150" HorizontalAlignment="Left" Click="ClearLog_Click"/>
                    <Button Content="Save" Width="100" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon" 
                IconSource="pack://application:,,,/icon.ico" 
                ToolTipText="Backup Manager Pro"/>
    </Grid>
</Window>